{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "action"],
  "properties": {
    "questionCount": { "type": "integer", "minimum": 0, "maximum": 5 },
    "decision": { "$ref": "#/definitions/slot" },
    "action": { "$ref": "#/definitions/slot" },
    "questionShape": { "$ref": "#/definitions/questionShapeSlot" },
    "actionShape": { "$ref": "#/definitions/actionShapeSlot" },
    "exception": { "$ref": "#/definitions/slot" },
    "diagnosis": { "$ref": "#/definitions/slot" },
    "audience": { "$ref": "#/definitions/slot" },
    "cadence": { "$ref": "#/definitions/slot" },
    "contextRequirements": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/definitions/contextRequirement" }
    }
  },
  "definitions": {
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "inferred", "absent"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "questionShapeSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "inferred", "absent"] },
        "value": { "enum": ["state", "priority", "cause", "comparison", "allocation", "exploration"] }
      }
    },
    "actionShapeSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["confirmed", "inferred", "absent"] },
        "value": { "enum": ["observe", "rank", "investigate", "choose", "allocate", "explore"] }
      }
    },
    "contextRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "subject", "minimumCoverage", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^ctx_[A-Za-z0-9_~.-]{1,64}$" },
        "type": {
          "enum": [
            "relative_comparison",
            "distribution_shape",
            "ranking_span",
            "temporal_reference",
            "target_reference",
            "gap_attribution",
            "contributor_comparison",
            "decomposition"
          ]
        },
        "subject": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "minimumCoverage": {
          "enum": [
            "current_plus_reference",
            "full_distribution",
            "both_ends",
            "target_and_gap",
            "contributors",
            "full_breakdown"
          ]
        },
        "status": { "enum": ["confirmed", "inferred", "source"] }
      }
    }
  }
}
