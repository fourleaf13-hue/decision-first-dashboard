{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    { "$ref": "#/definitions/noScoreState" },
    { "$ref": "#/definitions/compositeState" }
  ],
  "definitions": {
    "noScoreState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "signals"],
      "properties": {
        "mode": { "const": "no_score" },
        "signals": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "$ref": "#/definitions/signal" }
        },
        "supportingSignals": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/definitions/supportingSignal" }
        },
        "radarScale": { "$ref": "#/definitions/radarScale" },
        "context": { "$ref": "#/definitions/noScoreContext" },
        "semanticNodes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/definitions/semanticNode" }
        },
        "visibleClaims": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/definitions/visibleClaim" }
        },
        "exceptions": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/definitions/exception" }
        },
        "events": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/definitions/event" }
        }
      }
    },
    "compositeState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "score", "model"],
      "properties": {
        "mode": { "const": "composite" },
        "score": { "$ref": "#/definitions/score" },
        "model": { "$ref": "#/definitions/scoreModel" },
        "context": { "$ref": "#/definitions/scoreContext" },
        "exceptions": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/definitions/exception" }
        },
        "events": {
          "type": "array",
          "maxItems": 5,
          "items": { "$ref": "#/definitions/event" }
        },
        "visibleClaims": {
          "type": "array",
          "maxItems": 24,
          "items": { "$ref": "#/definitions/visibleClaim" }
        }
      }
    },
    "signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "label", "value", "provenance"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "value": { "type": "string", "minLength": 1, "maxLength": 24 },
        "delta": { "type": "string", "minLength": 1, "maxLength": 20 },
        "direction": { "enum": ["improving", "deteriorating", "flat", "unknown"] },
        "normalizedScore": { "type": "number" },
        "previousNormalizedScore": { "type": "number" },
        "provenance": { "enum": ["source", "derived"] }
      }
    },
    "supportingSignal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "label", "value", "provenance"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "value": { "type": "string", "minLength": 1, "maxLength": 24 },
        "delta": { "type": "string", "minLength": 1, "maxLength": 20 },
        "direction": { "enum": ["improving", "deteriorating", "flat", "unknown"] },
        "provenance": { "enum": ["source", "derived"] }
      }
    },
    "radarScale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "provenance"],
      "properties": {
        "min": { "type": "number" },
        "max": { "type": "number" },
        "provenance": { "const": "source" }
      }
    },
    "noScoreContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revenueSeries", "provenance"],
      "properties": {
        "revenueSeries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": { "type": "number", "minimum": 0 }
        },
        "provenance": { "const": "source" }
      }
    },
    "semanticNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "title", "items"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "type": {
          "enum": ["MetricCluster", "Trend", "Distribution", "Breakdown", "Ranking", "Relationship", "ExceptionList", "Drilldown"]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "subtitle": { "type": "string", "maxLength": 160 },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": { "$ref": "#/definitions/semanticItem" }
        }
      }
    },
    "semanticItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "provenance"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "value": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 80 }, { "type": "number" }] },
        "detail": { "type": "string", "maxLength": 120 },
        "role": { "enum": ["actual", "target", "gap", "point", "member", "contributor", "rank", "detail", "dimension"] },
        "provenance": { "const": "source" }
      }
    },
    "visibleClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "claimType", "scope", "text", "evidenceRefs"],
      "properties": {
        "id": { "type": "string", "pattern": "^claim_[a-z0-9_]{1,64}$" },
        "claimType": { "enum": ["overall_direction", "overall_verdict", "score_band", "metric_summary", "comparison", "exception_summary"] },
        "scope": { "enum": ["overall", "node", "metric"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 240 },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "type": "string", "pattern": "^ev_[A-Za-z0-9_~.-]{1,120}$" }
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "min", "max", "band", "provenance"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 40 },
        "value": { "type": "number" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "band": { "type": "string", "minLength": 1, "maxLength": 32 },
        "provenance": { "const": "source" }
      }
    },
    "scoreModel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalization", "aggregation", "provenance", "components", "bands"],
      "properties": {
        "normalization": { "const": "source_provided" },
        "aggregation": { "const": "weighted_average" },
        "provenance": { "const": "source" },
        "components": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "$ref": "#/definitions/scoreComponent" }
        },
        "bands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": { "$ref": "#/definitions/scoreBand" }
        }
      }
    },
    "scoreComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "label", "value", "normalizedScore", "weight", "provenance"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[a-z0-9_]{1,40}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 24 },
        "value": { "type": "string", "minLength": 1, "maxLength": 24 },
        "normalizedScore": { "type": "number" },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "provenance": { "const": "source" }
      }
    },
    "scoreBand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "min", "max", "provenance"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "provenance": { "const": "source" }
      }
    },
    "scoreContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoreSeries", "provenance"],
      "properties": {
        "scoreSeries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 24,
          "items": { "type": "number" }
        },
        "provenance": { "const": "source" }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "provenance"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40 },
        "plan": { "type": "string", "maxLength": 24 },
        "mrr": { "type": "string", "maxLength": 24 },
        "status": { "type": "string", "minLength": 1, "maxLength": 24 },
        "provenance": { "const": "source" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "event", "time", "provenance"],
      "properties": {
        "subject": { "type": "string", "minLength": 1, "maxLength": 40 },
        "event": { "type": "string", "minLength": 1, "maxLength": 40 },
        "detail": { "type": "string", "maxLength": 50 },
        "time": { "type": "string", "minLength": 1, "maxLength": 24 },
        "provenance": { "const": "source" }
      }
    }
  }
}
