{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "action", "inventoryCount", "metrics"],
  "properties": {
    "decision": { "type": "string", "minLength": 1, "maxLength": 240 },
    "action": { "type": "string", "minLength": 1, "maxLength": 240 },
    "inventoryCount": { "type": "integer", "minimum": 1, "maximum": 200 },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/definitions/metricRoute" }
    },
    "compositionNodes": {
      "type": "array",
      "maxItems": 24,
      "items": { "$ref": "#/definitions/compositionNode" }
    },
    "compositionModifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "density": { "enum": ["full", "compact"] },
        "activeModifierIds": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "pattern": "^[a-z0-9_~.-]{1,64}$" }
        }
      }
    },
    "decisionLog": {
      "type": "array",
      "maxItems": 48,
      "items": { "$ref": "#/definitions/decisionLogEntry" }
    }
  },
  "definitions": {
    "decisionLogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "decision", "reasonCode"],
      "properties": {
        "node": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "decision": { "enum": ["promote", "retain_full", "collapse_to_drilldown", "drop"] },
        "reasonCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,80}$" },
        "requirementRef": { "type": "string", "pattern": "^ctx_[A-Za-z0-9_~.-]{1,64}$" },
        "modifierRef": { "type": "string", "pattern": "^[a-z0-9_~.-]{1,64}$" }
      }
    },
    "metricRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "role", "changesDecision", "visibility"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "role": {
          "enum": ["primary_signal", "diagnostic", "exception", "drilldown", "scorecard_only"]
        },
        "changesDecision": { "type": "boolean" },
        "decisionImpact": { "type": "string", "minLength": 1, "maxLength": 240 },
        "visibility": {
          "enum": ["first_view", "supporting", "on_demand", "scorecard"]
        },
        "explains": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "active": { "type": "boolean" },
        "surfacePath": { "type": "string", "pattern": "^/(exceptions|events)/[0-9]+$" }
      }
    },
    "compositionNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "metric": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "type": {
          "enum": [
            "MetricCluster",
            "Trend",
            "Distribution",
            "Breakdown",
            "Ranking",
            "Relationship",
            "ExceptionList",
            "Drilldown"
          ]
        },
        "presentation": {
          "enum": [
            "full_chart",
            "sparkline",
            "summary",
            "peak_summary",
            "full_breakdown",
            "both_ends",
            "full_ranking",
            "top_summary",
            "full_list",
            "compact_list",
            "reachable_detail",
            "radar",
            "comparison",
            "bullet_target",
            "waterfall"
          ]
        },
        "compactPresentation": {
          "enum": [
            "full_chart",
            "sparkline",
            "summary",
            "peak_summary",
            "full_breakdown",
            "both_ends",
            "full_ranking",
            "top_summary",
            "full_list",
            "compact_list",
            "reachable_detail",
            "radar",
            "comparison"
          ]
        },
        "dimensions": {
          "type": "array",
          "minItems": 3,
          "maxItems": 6,
          "items": { "$ref": "#/definitions/profileDimension" }
        },
        "profile": { "$ref": "#/definitions/profileContract" },
        "comparability": { "$ref": "#/definitions/comparability" }
      }
    },
    "profileDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric", "unit", "value", "normalizedScore"],
      "properties": {
        "metric": { "type": "string", "pattern": "^[a-z0-9_]{1,64}$" },
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "value": { "oneOf": [{ "type": "string", "minLength": 1, "maxLength": 80 }, { "type": "number" }] },
        "normalizedScore": { "type": "number" },
        "comparisonGroup": { "type": "string", "pattern": "^[a-z0-9_~.-]{1,64}$" },
        "comparabilityDomain": { "type": "string", "pattern": "^[a-z0-9_~.-]{1,64}$" },
        "normalization": { "enum": ["raw", "source_normalized", "percentage_of_total", "index"] },
        "scaleId": { "type": "string", "pattern": "^[a-z0-9_~.:-]{1,80}$" }
      }
    },
    "profileContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "sharedScale", "comparable"],
      "properties": {
        "purpose": { "enum": ["profile", "comparison"] },
        "sharedScale": { "type": "boolean" },
        "comparable": { "type": "boolean" }
      }
    },
    "comparability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "comparisonGroup", "comparabilityDomain"],
      "properties": {
        "unit": { "type": "string", "minLength": 1, "maxLength": 40 },
        "comparisonGroup": { "type": "string", "pattern": "^[a-z0-9_~.-]{1,64}$" },
        "comparabilityDomain": { "type": "string", "pattern": "^[a-z0-9_~.-]{1,64}$" },
        "normalization": { "enum": ["raw", "source_normalized", "percentage_of_total", "index"] },
        "scaleId": { "type": "string", "pattern": "^[a-z0-9_~.:-]{1,80}$" },
        "scale": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z0-9_~.:-]{1,80}$" },
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        }
      }
    }
  }
}
