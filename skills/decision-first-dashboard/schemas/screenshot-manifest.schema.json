{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "imageSha256", "width", "height", "engine", "tokens"],
  "properties": {
    "version": { "const": 1 },
    "imageSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "engine": { "const": "tesseract" },
    "tokens": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/token" }
    }
  },
  "definitions": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "confidence", "bbox"],
      "properties": {
        "id": { "type": "string", "pattern": "^tok_[0-9]{6}$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 300 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 100 },
        "bbox": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "integer", "minimum": 0 },
            "y": { "type": "integer", "minimum": 0 },
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
