{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "decisionState", "evidence", "claims"],
  "properties": {
    "contractVersion": { "const": "3.1" },
    "intent": { "$ref": "#/definitions/intent" },
    "source": { "$ref": "#/definitions/source" },
    "decisionState": { "type": "object" },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/evidence" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/claim" }
    }
  },
  "definitions": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audience", "audienceType", "purpose", "primaryDecision", "refreshCadence", "requirements"],
      "properties": {
        "audience": { "type": "string", "minLength": 1, "maxLength": 80 },
        "audienceType": { "enum": ["executive", "operational", "diagnostic"] },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 160 },
        "primaryDecision": { "type": "string", "minLength": 1, "maxLength": 200 },
        "refreshCadence": { "enum": ["realtime", "hourly", "daily", "weekly", "monthly"] },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": { "$ref": "#/definitions/requirement" }
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "resolution"],
      "properties": {
        "id": { "type": "string", "pattern": "^req_[A-Za-z0-9_~.-]{1,120}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": {
          "enum": [
            "single_value",
            "trend",
            "comparison",
            "composition",
            "distribution",
            "relationship",
            "status",
            "action",
            "evidence"
          ]
        },
        "resolution": {
          "oneOf": [
            { "$ref": "#/definitions/decisionPathResolution" },
            { "$ref": "#/definitions/deferredResolution" }
          ]
        }
      }
    },
    "decisionPathResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "decision_path" },
        "path": { "type": "string", "pattern": "^/" }
      }
    },
    "deferredResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "blockedBy", "originalSpec", "toUnblock"],
      "properties": {
        "type": { "const": "deferred" },
        "blockedBy": {
          "enum": ["missing_source_fact", "ambiguous_source", "unsupported_computation", "unsupported_renderer"]
        },
        "originalSpec": { "type": "string", "minLength": 1, "maxLength": 240 },
        "toUnblock": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256"],
      "properties": {
        "kind": { "enum": ["json", "text"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 240 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "anchor"],
      "properties": {
        "id": { "type": "string", "pattern": "^ev_[A-Za-z0-9_~.-]{1,120}$" },
        "anchor": {
          "oneOf": [
            { "$ref": "#/definitions/jsonAnchor" },
            { "$ref": "#/definitions/textAnchor" }
          ]
        }
      }
    },
    "jsonAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "pointer"],
      "properties": {
        "type": { "const": "json_pointer" },
        "pointer": { "type": "string", "pattern": "^/" }
      }
    },
    "textAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "literal", "valueText"],
      "properties": {
        "type": { "const": "text_span" },
        "literal": { "type": "string", "minLength": 1, "maxLength": 500 },
        "valueText": { "type": "string", "minLength": 1, "maxLength": 200 },
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 1 }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decisionPath", "evidenceRef"],
      "properties": {
        "decisionPath": { "type": "string", "pattern": "^/" },
        "evidenceRef": { "type": "string", "pattern": "^ev_[A-Za-z0-9_~.-]{1,120}$" }
      }
    }
  }
}
